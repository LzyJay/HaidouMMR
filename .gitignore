# ============================================================
#  HaidouMMR — 版本控制忽略规则
#
#  设计原则：只提交「源码 + 文档 + 测试」。
#  凡是「跑一次就能重新生成」或「体积巨大」的东西一律排除。
# ============================================================


# ------------------------------------------------------------
# ① 可再生产物：构建 / 打包输出
#    由 06_桌面版/requirements.txt + build.bat 完整重建。
#    ⚠️ .gitignore 不剥离行尾空格 —— 不要把 # 注释写在同一行末尾，
#       尾随空格会变成模式的一部分而永不匹配。注释一律另起一行。
# ------------------------------------------------------------
06_桌面版/.venv-build/
06_桌面版/build/
06_桌面版/dist/
HaidouMMR/
HaidouMMR/_internal/_scripts/


# ------------------------------------------------------------
# ② Python / Node 缓存
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
node_modules/
.npm/


# ------------------------------------------------------------
# ③ 运行期数据与生成物
#
#    02_数据/ 里全是「跑一次就重新生成」或「属于个人战绩」的东西：
#      - hd_data.json / player_elo.json        原始对局与评分底表（几十 MB）
#      - my_stats.json / 海斗roster.json        个人逐局明细
#      - _desktop_state.json / _last_job.log    运行期状态与日志
#    → 全部排除。只留一个 .gitkeep 占位，保证目录存在。
# ------------------------------------------------------------
02_数据/*
!02_数据/.gitkeep

# 看板 HTML 是 _dash_rebuild.py 生成的产物（内嵌约 0.8 MB JSON），
# 每次数据刷新都会产生巨大 diff，进 git 会让历史被噪音淹没。
# ⚠️ 但样式真身是 06_桌面版/theme.css + apply_*.py，那三个是**提交**的。
03_看板/*.html
03_看板/*.htm
!03_看板/.gitkeep

# 语义化产物文件名（防将来 _dash_rebuild 改名后漏排除）
/*dashboard_data*.json
_estim*.json
_probe*.json


# ------------------------------------------------------------
# ④ 备份堆
#    约定：备份永不硬删，一律用移动代替删除；
#          备份也不进版本库，否则等于把仓库变成备份仓。
# ------------------------------------------------------------
_stale/
_backup_*/
*.bak
*.bak.*
*.pre_*.bak.*
*_pre_*


# ------------------------------------------------------------
# ⑤ 编辑器 / 系统噪音
# ------------------------------------------------------------
.codebuddy/
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store


# ------------------------------------------------------------
# ⑥ 密钥与环境（永不提交）
# ------------------------------------------------------------
.env
.env.*
*.pem
*.key
secrets/


# ------------------------------------------------------------
# ⑦ 明确【要】提交的东西（白名单式说明，防止后人误加进上面）
#
#    00_使用说明.md                  权威手册：文件清单 / schema / 55 条改码铁律
#    01_脚本/*.py                    算法管线（纯标准库，零第三方依赖）
#    01_脚本/*.js                    Node + jsdom 看板断言
#    01_脚本/验证看板.bat             断言入口
#    04_文档/*.md                    复刻指南 / 算法解读 / 估算说明 / SKILL
#    06_桌面版/app.py                桌面外壳
#    06_桌面版/build.py|build.bat    打包流程
#    06_桌面版/theme.css             样式唯一真身（⚠️ 单向注入，勿直接改 HTML）
#    06_桌面版/apply_*.py            注入工具
#    06_桌面版/requirements.txt      依赖清单
#    06_桌面版/icon.ico|png          静态资源
#    07_测试/*.py                    测试与断言公共模块
# ------------------------------------------------------------
